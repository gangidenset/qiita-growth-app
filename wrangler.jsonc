// Cloudflare Workers の設定（Cloudflare の画面で Git から作ると、Deploy command の `npx wrangler deploy` がこれを読む）
{
  "name": "qiita-growth-app",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 画面のファイルより先に worker.js を通す（/api/ の処理と、安全のためのヘッダーを付けるため）
    "run_worker_first": true
  },
  // Cloudflare の画面で入れた変数を、公開のたびに消さない
  "keep_vars": true,
  "observability": { "enabled": true }
}
